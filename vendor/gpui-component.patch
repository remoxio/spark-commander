+pub(crate) fn pop_up_entries(
+    entries: Vec<NativeEntry>,
+    position: Point<Pixels>,
+    window: &mut Window,
+    cx: &mut App,
+    picked: impl FnOnce(Vec<usize>, &mut Window, &mut App) + 'static,
+) {
+    let Some(view_ptr) = ns_view_ptr(window) else {
+        return;
+    };
